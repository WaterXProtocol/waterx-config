{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://config.waterx.app/schema/waterx-config-target.schema.json",
  "title": "waterx-config network file (flip target)",
  "description": "The consolidated post-flip shape (docs/FLIP-PLAN.md): one symbol universe, uniform package identity, domain-grouped shared objects, and a named per-rule oracle registry. Until flip day this validates the LIFTED form of the served files; on flip day it becomes the schema of mainnet.json/testnet.json themselves.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "network": {
      "enum": [
        "mainnet",
        "testnet"
      ]
    },
    "chain_id": {
      "type": "string",
      "minLength": 4
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "perp",
              "spot",
              "xstock",
              "commodity",
              "fx",
              "prediction"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "description": "The single symbol universe: the ONLY place a symbol is introduced. Every symbol-keyed map elsewhere must reference a key from here (CI-enforced)."
    },
    "objects": {
      "type": "object",
      "properties": {
        "oracle": {
          "type": "object",
          "properties": {
            "oracle": {
              "$ref": "#/$defs/suiId"
            },
            "listing_cap": {
              "$ref": "#/$defs/suiId"
            },
            "aggregators": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/suiId"
              }
            }
          },
          "required": [
            "aggregators",
            "listing_cap",
            "oracle"
          ],
          "additionalProperties": false
        },
        "perp": {
          "type": "object",
          "properties": {
            "global_config": {
              "$ref": "#/$defs/suiId"
            },
            "admin_cap": {
              "$ref": "#/$defs/suiId"
            },
            "market_registry_wlp": {
              "$ref": "#/$defs/suiId"
            },
            "markets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "market": {
                    "$ref": "#/$defs/suiId"
                  },
                  "config": {
                    "$ref": "#/$defs/suiId"
                  }
                },
                "required": [
                  "config",
                  "market"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "admin_cap",
            "global_config",
            "market_registry_wlp",
            "markets"
          ],
          "additionalProperties": false
        },
        "wlp": {
          "type": "object",
          "properties": {
            "pool": {
              "$ref": "#/$defs/suiId"
            },
            "aum": {
              "$ref": "#/$defs/suiId"
            },
            "currency_type": {
              "$ref": "#/$defs/suiId"
            },
            "metadata_cap": {
              "$ref": "#/$defs/suiId"
            },
            "pool_tokens": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/suiType"
              }
            }
          },
          "required": [
            "aum",
            "currency_type",
            "metadata_cap",
            "pool",
            "pool_tokens"
          ],
          "additionalProperties": false
        },
        "staking": {
          "type": "object",
          "properties": {
            "admin_cap": {
              "$ref": "#/$defs/suiId"
            },
            "pools": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/suiId"
              }
            },
            "rewarders": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "USDC": {
                    "type": "object",
                    "properties": {
                      "rewarder_id": {
                        "$ref": "#/$defs/suiId"
                      },
                      "coin_type": {
                        "$ref": "#/$defs/suiType"
                      },
                      "decimals": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "coin_type",
                      "decimals",
                      "rewarder_id"
                    ],
                    "additionalProperties": false
                  },
                  "DEEP": {
                    "type": "object",
                    "properties": {
                      "rewarder_id": {
                        "$ref": "#/$defs/suiId"
                      },
                      "coin_type": {
                        "$ref": "#/$defs/suiType"
                      },
                      "decimals": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "coin_type",
                      "decimals",
                      "rewarder_id"
                    ],
                    "additionalProperties": false
                  },
                  "MOCK_DEEP": {
                    "type": "object",
                    "properties": {
                      "rewarder_id": {
                        "$ref": "#/$defs/suiId"
                      },
                      "coin_type": {
                        "$ref": "#/$defs/suiType"
                      },
                      "decimals": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "coin_type",
                      "decimals",
                      "rewarder_id"
                    ],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "admin_cap",
            "pools",
            "rewarders"
          ]
        },
        "account": {
          "type": "object",
          "properties": {
            "registry": {
              "$ref": "#/$defs/suiId"
            },
            "admin_cap": {
              "$ref": "#/$defs/suiId"
            }
          },
          "required": [
            "admin_cap",
            "registry"
          ],
          "additionalProperties": false
        },
        "referral": {
          "type": "object",
          "properties": {
            "table": {
              "$ref": "#/$defs/suiId"
            }
          },
          "required": [
            "table"
          ],
          "additionalProperties": false
        },
        "credit": {
          "type": "object",
          "properties": {
            "registry": {
              "$ref": "#/$defs/suiId"
            },
            "credit_type": {
              "$ref": "#/$defs/suiType"
            }
          },
          "required": [
            "credit_type",
            "registry"
          ],
          "additionalProperties": false
        },
        "custody": {
          "type": "object",
          "properties": {
            "vault": {
              "$ref": "#/$defs/suiId"
            },
            "assets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "$ref": "#/$defs/suiType"
                  },
                  "decimal": {
                    "type": "integer"
                  },
                  "mint_fee_scaled": {
                    "$ref": "#/$defs/decString"
                  },
                  "burn_fee_scaled": {
                    "$ref": "#/$defs/decString"
                  },
                  "min_burn_amount": {
                    "$ref": "#/$defs/decString"
                  }
                },
                "required": [
                  "burn_fee_scaled",
                  "decimal",
                  "min_burn_amount",
                  "mint_fee_scaled",
                  "name",
                  "type"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "assets",
            "vault"
          ],
          "additionalProperties": false
        },
        "bridge": {
          "type": "object",
          "properties": {
            "state": {
              "$ref": "#/$defs/suiId"
            },
            "emitter_cap": {
              "$ref": "#/$defs/suiId"
            },
            "wormhole_state": {
              "$ref": "#/$defs/suiId"
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_mint_per_tx": {
                  "$ref": "#/$defs/decString"
                },
                "max_burn_per_tx": {
                  "$ref": "#/$defs/decString"
                },
                "daily_mint": {
                  "$ref": "#/$defs/decString"
                },
                "daily_burn": {
                  "$ref": "#/$defs/decString"
                },
                "personal_burn": {
                  "type": "object",
                  "properties": {
                    "cap_amount": {
                      "$ref": "#/$defs/decString"
                    },
                    "window_ms": {
                      "$ref": "#/$defs/decString"
                    }
                  },
                  "required": [
                    "cap_amount",
                    "window_ms"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "daily_burn",
                "daily_mint",
                "max_burn_per_tx",
                "max_mint_per_tx",
                "personal_burn"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "emitter_cap",
            "limits",
            "state",
            "wormhole_state"
          ],
          "additionalProperties": false
        },
        "withdrawal_queue": {
          "type": "object",
          "properties": {
            "queue": {
              "$ref": "#/$defs/suiId"
            },
            "executors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/suiId"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "queue"
          ]
        },
        "prediction": {
          "type": "object",
          "properties": {
            "global_config": {
              "$ref": "#/$defs/suiId"
            },
            "admin_cap": {
              "$ref": "#/$defs/suiId"
            },
            "market_registries": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/suiId"
              }
            },
            "settlement_coin_types": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/suiType"
              }
            },
            "claimable_link_config": {
              "$ref": "#/$defs/suiId"
            },
            "gift_admin_cap": {
              "$ref": "#/$defs/suiId"
            }
          },
          "required": [
            "admin_cap",
            "claimable_link_config",
            "gift_admin_cap",
            "global_config",
            "market_registries",
            "settlement_coin_types"
          ],
          "additionalProperties": false
        },
        "usd": {
          "type": "object",
          "properties": {
            "metadata_cap": {
              "$ref": "#/$defs/suiId"
            }
          },
          "required": [
            "metadata_cap"
          ],
          "additionalProperties": false
        },
        "faucet": {
          "type": "object",
          "properties": {
            "faucet": {
              "$ref": "#/$defs/suiId"
            },
            "whitelist": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/suiId"
              }
            }
          },
          "required": [
            "faucet",
            "whitelist"
          ],
          "additionalProperties": false
        },
        "mock_usdsui": {
          "type": "object",
          "properties": {
            "currency_type": {
              "$ref": "#/$defs/suiId"
            },
            "metadata_cap": {
              "$ref": "#/$defs/suiId"
            },
            "treasury_cap": {
              "$ref": "#/$defs/suiId"
            }
          },
          "required": [
            "currency_type",
            "metadata_cap",
            "treasury_cap"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "account",
        "bridge",
        "credit",
        "custody",
        "oracle",
        "perp",
        "prediction",
        "referral",
        "staking",
        "usd",
        "withdrawal_queue",
        "wlp"
      ]
    },
    "oracle_rules": {
      "type": "object",
      "properties": {
        "waterx": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string"
            },
            "rule_config_object": {
              "$ref": "#/$defs/suiId"
            },
            "enclave": {
              "type": "object",
              "properties": {
                "object": {
                  "$ref": "#/$defs/suiId"
                },
                "cap": {
                  "$ref": "#/$defs/suiId"
                },
                "config": {
                  "$ref": "#/$defs/suiId"
                },
                "pubkey": {
                  "type": "string"
                }
              },
              "required": [
                "cap",
                "config",
                "object",
                "pubkey"
              ],
              "additionalProperties": false,
              "description": "The ONE home for enclave identity (object, cap, config, pubkey)."
            },
            "venue_feeds": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "ticker": {
                    "type": "string"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "weight": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "name",
                        "weight"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "method": {
                    "type": "string"
                  },
                  "min_sources": {
                    "type": "integer"
                  }
                },
                "required": [
                  "method",
                  "min_sources",
                  "sources",
                  "ticker"
                ],
                "additionalProperties": false
              },
              "description": "QC feed registry (was packages.waterx_rule.feeds). `weights` remain OFF-CHAIN ONLY — audit-scope I-16 trust surface."
            }
          },
          "required": [
            "enclave",
            "package",
            "rule_config_object",
            "venue_feeds"
          ],
          "additionalProperties": false
        },
        "pyth": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string"
            },
            "pyth_config_object": {
              "$ref": "#/$defs/suiId"
            },
            "pyth_price_feeds": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "feed_id": {
                    "$ref": "#/$defs/suiId"
                  },
                  "price_info_object": {
                    "$ref": "#/$defs/suiId"
                  }
                },
                "required": [
                  "feed_id",
                  "price_info_object"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "package",
            "pyth_config_object",
            "pyth_price_feeds"
          ]
        },
        "pyth_lazer": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string"
            },
            "lazer_state_object": {
              "$ref": "#/$defs/suiId"
            },
            "lazer_config_object": {
              "$ref": "#/$defs/suiId"
            },
            "lazer_feed_ids": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          },
          "required": [
            "lazer_config_object",
            "lazer_feed_ids",
            "lazer_state_object",
            "package"
          ],
          "additionalProperties": false
        },
        "constant": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string"
            },
            "rule_config_object": {
              "$ref": "#/$defs/suiId"
            },
            "constant_prices": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "price": {
                    "$ref": "#/$defs/decString"
                  }
                },
                "required": [
                  "price"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "constant_prices",
            "package",
            "rule_config_object"
          ],
          "additionalProperties": false
        },
        "supra": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string"
            },
            "rule_config_object": {
              "$ref": "#/$defs/suiId"
            },
            "pair_ids": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          },
          "required": [
            "package",
            "pair_ids",
            "rule_config_object"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "constant",
        "pyth",
        "waterx"
      ]
    },
    "coin_registry": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{1,64}$",
      "description": "Short-form Sui address/object id."
    },
    "evm": {
      "type": "object",
      "properties": {
        "bridge": {
          "type": "object",
          "properties": {
            "chains": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "chain_id": {
                    "type": "integer"
                  },
                  "wormhole_chain_id": {
                    "type": "integer"
                  },
                  "wormhole_core": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{1,64}$",
                    "description": "Short-form Sui address/object id."
                  },
                  "wormhole_executor": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{1,64}$",
                    "description": "Short-form Sui address/object id."
                  },
                  "block_explorer": {
                    "type": "string"
                  },
                  "deposit_vault": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{1,64}$",
                    "description": "Short-form Sui address/object id."
                  },
                  "tokens": {
                    "type": "object",
                    "properties": {
                      "USDC": {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{1,64}$",
                        "description": "Short-form Sui address/object id."
                      },
                      "USDT": {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{1,64}$",
                        "description": "Short-form Sui address/object id."
                      },
                      "tUSDC": {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{1,64}$",
                        "description": "Short-form Sui address/object id."
                      },
                      "tUSDT": {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{1,64}$",
                        "description": "Short-form Sui address/object id."
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "required": [
                  "block_explorer",
                  "chain_id",
                  "deposit_vault",
                  "tokens",
                  "wormhole_chain_id",
                  "wormhole_core",
                  "wormhole_executor"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "chains"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "bridge"
      ]
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "published_at": {
            "$ref": "#/$defs/suiId",
            "description": "Package id of the current latest version — the tx-call target. Changes on every upgrade."
          },
          "original_id": {
            "$ref": "#/$defs/suiId",
            "description": "Package id of the FIRST publish. Never changes across upgrades; used to build type tags (<original_id>::module::Type)."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "On-chain package version: 1 at first publish, +1 per upgrade."
          },
          "upgrade_capability": {
            "$ref": "#/$defs/suiId",
            "description": "UpgradeCap object id. Deploy-time artifact; no runtime consumer."
          },
          "mvr": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "package_info_id": {
                "$ref": "#/$defs/suiId"
              },
              "app_cap_id": {
                "$ref": "#/$defs/suiId"
              },
              "git": {
                "type": "object",
                "properties": {
                  "repo": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer"
                  }
                },
                "required": [
                  "repo",
                  "path",
                  "version"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "package_info_id",
              "app_cap_id"
            ],
            "additionalProperties": false,
            "description": "Move Registry (MVR) registration for this package. Mainnet only today."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "network",
    "chain_id",
    "symbols",
    "packages",
    "objects",
    "oracle_rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "suiId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "32-byte Sui object/package id."
    },
    "suiType": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{1,64}::[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Fully-qualified Move type tag."
    },
    "decString": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Unsigned integer as a decimal string — used where values may exceed 2^53 (u64/u128 amounts, 1e9-scaled prices)."
    }
  }
}