{
  "permissions": {
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin staging:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push -u origin staging:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/ask-before-publish.sh",
            "timeout": 10,
            "statusMessage": "publish check"
          }
        ]
      }
    ]
  }
}
