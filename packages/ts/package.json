{
  "name": "@waterx-protocol/config",
  "version": "0.1.0",
  "description": "Typed loader for waterx-config network files: one consolidated shape, legacy documents lifted transparently until flip day. Generated from the canonical JSON Schemas.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p .",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "ajv-cli": "5.0.0",
    "json-schema-to-zod": "2.6.1",
    "quicktype": "23.2.6",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
